{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "makersclubprojectspage",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GHOST_URL": "https://makeuoa.nz",
    "RESEND_FROM": "MAKE_UOA <noreply@makeuoa.nz>",
    "NEXT_PUBLIC_BASE_URL": "https://projects.makeuoa.nz"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "makersclubprojectspage"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
